# ==========================================
# REBOOY PANEL - PRODUCTION & DEV CONFIG
# ==========================================

# Django Core Settings
SECRET_KEY=your-production-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL for production, SQLite used automatically if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/rebooypanel
# POSTGRES_DB=rebooypanel
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=yourpassword
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# CONN_MAX_AGE=600

# Celery & Redis (Set USE_CELERY=True for distributed workers)
USE_CELERY=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Facebook Fan Extractor
EXTRACTOR_PROXY_URL=http://proxy_user:proxy_pass@proxy_host:proxy_port
# Multiple proxies can be comma-separated:
# EXTRACTOR_PROXIES=http://p1:8080,http://p2:8080
EXTRACTOR_CONCURRENCY=10
EXTRACTOR_TIMEOUT=15.0

# Alerts & Webhooks (Discord, Telegram, or generic JSON endpoint)
EXTRACTOR_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# AI Studio (Google Gemini API Keys)
# GEMINI_API_KEY=AIzaSy...
